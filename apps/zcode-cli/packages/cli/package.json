{
  "name": "@zhlbuilder/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for zhlbuilder",
  "bin": {
    "zhlbuilder": "./dist/zhlbuilder.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/zhlbuilder.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/zcode-cli run build --filter=!@zhlbuilder/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@zhlbuilder/adapters": "workspace:*",
    "@zhlbuilder/bootstrap": "workspace:*",
    "@zhlbuilder/contracts": "workspace:*",
    "@zhlbuilder/core": "workspace:*",
    "@zhlbuilder/dynamic-workflow-runtime": "workspace:*",
    "@zhlbuilder/i18n": "workspace:*",
    "@zhlbuilder/provider-node": "workspace:*",
    "@zhlbuilder/shared": "workspace:*",
    "@zhlbuilder/shared-types": "workspace:*",
    "@zhlbuilder/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1",
    "qrcode": "^1.5.4"
  }
}
